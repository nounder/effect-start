#!/usr/bin/env bun
/**
 * Bundles src/datastar/index.ts into a plain-JS artifact so Studio can serve
 * it to the browser without depending on the generic Bundle context. Run
 * this whenever files under src/datastar/ change.
 */
import * as NPath from "node:path"

const root = NPath.join(import.meta.dir, "..")

const result = await Bun.build({
  entrypoints: [NPath.join(root, "src/datastar/index.ts")],
  target: "browser",
  format: "esm",
})

if (!result.success) {
  for (const log of result.logs) console.error(log)
  process.exit(1)
}

const code = await result.outputs[0]!.text()
const outPath = NPath.join(root, "src/studio/internal/DatastarClient.ts")

await Bun.write(
  outPath,
  `// Generated by \`bun scripts/build-datastar-client\` from src/datastar/. Do not edit by hand.\nexport default ${JSON.stringify(code)}\n`,
)

console.log(`Wrote ${outPath} (${code.length} bytes)`)
