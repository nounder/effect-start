{
  "name": "effect-start",
  "version": "0.50.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nounder/effect-start.git"
  },
  "files": [
    "src/",
    "dist/",
    "README.md",
    "package.json"
  ],
  "type": "module",
  "engines": {
    "bun": ">=1.4.1"
  },
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./Development": {
      "bun": "./src/Development.ts",
      "default": "./dist/Development.js"
    },
    "./Entity": {
      "bun": "./src/Entity.ts",
      "default": "./dist/Entity.js"
    },
    "./esbuild": {
      "bun": "./src/esbuild/index.ts",
      "default": "./dist/esbuild/index.js"
    },
    "./rolldown": {
      "bun": "./src/rolldown/index.ts",
      "default": "./dist/rolldown/index.js"
    },
    "./Fetch": {
      "bun": "./src/Fetch.ts",
      "default": "./dist/Fetch.js"
    },
    "./FileRouter": {
      "bun": "./src/FileRouter.ts",
      "default": "./dist/FileRouter.js"
    },
    "./FileRouterCodegen": {
      "bun": "./src/FileRouterCodegen.ts",
      "default": "./dist/FileRouterCodegen.js"
    },
    "./GlobalLayer": {
      "bun": "./src/GlobalLayer.ts",
      "default": "./dist/GlobalLayer.js"
    },
    "./Html": {
      "bun": "./src/Html.ts",
      "default": "./dist/Html.js"
    },
    "./Password": {
      "bun": "./src/Password.ts",
      "default": "./dist/Password.js"
    },
    "./Route": {
      "bun": "./src/Route.ts",
      "default": "./dist/Route.js"
    },
    "./RouteError": {
      "bun": "./src/RouteError.ts",
      "default": "./dist/RouteError.js"
    },
    "./RouteHttp": {
      "bun": "./src/RouteHttp.ts",
      "default": "./dist/RouteHttp.js"
    },
    "./RouteHttpTracer": {
      "bun": "./src/RouteHttpTracer.ts",
      "default": "./dist/RouteHttpTracer.js"
    },
    "./Start": {
      "bun": "./src/Start.ts",
      "default": "./dist/Start.js"
    },
    "./StaticRoute": {
      "bun": "./src/StaticRoute.ts",
      "default": "./dist/StaticRoute.js"
    },
    "./Unique": {
      "bun": "./src/Unique.ts",
      "default": "./dist/Unique.js"
    },
    "./dev": "./src/dev.d.ts",
    "./internal/*": null,
    "./*/internal/*": null,
    "./assets.d.ts": "./src/assets.d.ts",
    "./jsx-runtime": {
      "bun": "./src/jsx-runtime.ts",
      "default": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "bun": "./src/jsx-runtime.ts",
      "default": "./dist/jsx-runtime.js"
    },
    "./lint/plugin": {
      "bun": "./src/lint/plugin.js",
      "default": "./dist/lint/plugin.js"
    },
    "./lint/config": {
      "bun": "./src/lint/config.ts",
      "default": "./dist/lint/config.js"
    },
    "./bun": {
      "bun": "./src/bun/index.ts",
      "default": "./dist/bun/index.js"
    },
    "./cloudflare": {
      "bun": "./src/cloudflare/index.ts",
      "default": "./dist/cloudflare/index.js"
    },
    "./datastar": {
      "bun": "./src/datastar/index.ts",
      "default": "./dist/datastar/index.js"
    },
    "./experimental/CsrfProtection": {
      "bun": "./src/experimental/CsrfProtection.ts",
      "default": "./dist/experimental/CsrfProtection.js"
    },
    "./experimental/EncryptedCookies": {
      "bun": "./src/experimental/EncryptedCookies.ts",
      "default": "./dist/experimental/EncryptedCookies.js"
    },
    "./experimental/SqlCache": {
      "bun": "./src/experimental/SqlCache.ts",
      "default": "./dist/experimental/SqlCache.js"
    },
    "./experimental/SqlIntrospect": {
      "bun": "./src/experimental/SqlIntrospect.ts",
      "default": "./dist/experimental/SqlIntrospect.js"
    },
    "./studio": {
      "bun": "./src/studio/index.ts",
      "default": "./dist/studio/index.js"
    },
    "./tailwind": {
      "bun": "./src/tailwind/index.ts",
      "default": "./dist/tailwind/index.js"
    },
    "./tailwind/plugin": {
      "bun": "./src/tailwind/plugin.ts",
      "default": "./dist/tailwind/plugin.js"
    },
    "./testing": {
      "bun": "./src/testing/index.ts",
      "default": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "lint": "oxlint && dprint check",
    "lint-fix": "oxlint --fix && dprint fmt",
    "test": "bun test ./test/",
    "bump": "bun scripts/bump",
    "prepublishOnly": "bun run build",
    "deploy": "bunx --bun npm publish --access public"
  },
  "devDependencies": {
    "@dprint/json": "^0.21.3",
    "@dprint/markdown": "^0.21.1",
    "@dprint/typescript": "^0.96.0",
    "@types/bun": "^1.3.4",
    "@types/jsdom": "^27.0.0",
    "dprint-cli": "^0.5.0",
    "effect": "4.0.0-rc.112",
    "esbuild": "^0.28.1",
    "jsdom": "^28.0.0",
    "oxlint": "^1.63.0",
    "rolldown": "^1.1.2",
    "tailwindcss": "^4.1.18",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "effect": "4.0.0-rc.112",
    "esbuild": ">=0.28.1",
    "rolldown": ">=1.1.2"
  },
  "peerDependenciesMeta": {
    "esbuild": {
      "optional": true
    },
    "rolldown": {
      "optional": true
    }
  },
  "sideEffects": []
}
